# Arcade Vault - Variables de Entorno

# Configuración de Resend para envío de correos desde la página Acerca de / Contacto
# Clave API generada en tu panel de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Remitente del correo. En pruebas puedes usar 'onboarding@resend.dev' o tu dominio verificado
RESEND_FROM_EMAIL=Arcade Vault <onboarding@resend.dev>

# Correo electrónico del equipo donde se recibirán los mensajes de contacto
CONTACT_NOTIFICATION_EMAIL=contacto@arcadevault.gg

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

